# Copie para .env e preencha localmente. Nunca envie nem publique o .env.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
# Caminho completo do ca.pem baixado no painel do Aiven (barras / funcionam no Windows)
MYSQL_SSL_CA=C:../certs/ca.pem

# Token exclusivo para autorizar o envio de bateria pelo app Android (minimo 32 caracteres).
# Gere um valor aleatorio com: python -c "import secrets; print(secrets.token_urlsafe(32))"
TABCONTROL_BATTERY_TOKEN=
# Porta HTTP do painel/API (opcional; padrao 8000).
TABCONTROL_PORT=8000
