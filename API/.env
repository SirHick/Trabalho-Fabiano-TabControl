# Copie este arquivo para ".env" (mesma pasta do Servidor.py) e preencha.
# NUNCA envie o arquivo .env para o GitHub.

# --- Obrigatorios ---
# Chave que o ESP32 envia ao servidor. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(16))"
TABCONTROL_API_KEY=c7ac44b5eee2a2a735e0408684c90ebb
# Login do painel web
TABCONTROL_ADMIN_USUARIO=admin
TABCONTROL_ADMIN_SENHA=1234

# --- Rede ---
TABCONTROL_HOST=0.0.0.0
TABCONTROL_PORTA=8000

# --- Regras ---
BATERIA_MINIMA=50
DIAS_MAX_ANTECEDENCIA=7
TOLERANCIA_RETIRADA_MIN=5
# Tempo (s) que o cracha continua "valendo" para pegar tablets
SESSAO_LEITURA_SEGUNDOS=30
# Tempo minimo (s) entre retirar e poder devolver o mesmo tablet
DEVOLUCAO_MIN_SEGUNDOS=60

# --- Email (deixe SMTP_HOST vazio para apenas simular no console) ---
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
EMAIL_ADMIN=administracao@exemplo.com

# --- So para testes ---
# TABCONTROL_DEMO=1 libera o botao "Carregar dados de exemplo"
TABCONTROL_DEMO=0
